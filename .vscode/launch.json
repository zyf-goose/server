{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug reactor",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/reactor",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "cmake: build reactor",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Debug tcp_client",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/tcp_client",
      "args": [
        "--host",
        "127.0.0.1",
        "--port",
        "8080",
        "--connections",
        "1",
        "--queries",
        "1",
        "--query-bytes",
        "16",
        "--threads",
        "1"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "cmake: build tcp_client",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
